# EchoAgent 环境变量
# docker compose 部署时会自动读取此文件

# ── Anthropic / DeepSeek ──────────────────────────────────────────────────────
# 模型服务的密钥，后端用它验证身份；使用 DeepSeek 官方服务时填你在 DeepSeek 平台创建的 Key。请勿公开。
ANTHROPIC_API_KEY=sk-aecbf9d7be4e4d98afd11877f8f75b24
# 发送请求时指定的模型 ID，决定由哪个模型回答。填服务商支持的 API 模型名。
ANTHROPIC_MODEL=deepseek-v4-pro
# 后端向哪个服务地址发送模型请求和上面的密钥。DeepSeek 官方的 Anthropic 兼容入口是 https://api.deepseek.com/anthropic。
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# ── 应用 ──────────────────────────────────────────────────────────────────────
# 运行模式。用 python -m api.main 启动网页后端时，development 会开启代码改动后自动重载。
APP_ENV=production
# 终端日志的详细程度。INFO 显示常规运行信息，DEBUG 更详细，WARNING 主要显示警告和错误。
LOG_LEVEL=INFO
# 用 python -m api.main 启动时，后端监听的网络地址。127.0.0.1 供本机访问，0.0.0.0 监听所有 IPv4 网卡。
API_HOST=0.0.0.0
# 用 python -m api.main 启动时，后端 API 的监听端口。若用 uvicorn --port 启动，端口由命令行指定。
API_PORT=8000

# ── Redis ─────────────────────────────────────────────────────────────────────
# Docker Compose 用它给 Redis 服务设置密码。已安装在 Windows 上的 Memurai 使用它自己的密码配置。
REDIS_PASSWORD=echomind123
# docker compose 内部地址（容器间通信）
# Python 后端用它连接 Redis，存取近期对话。当前 Windows 本机已验证可用的地址为 redis://127.0.0.1:6379/0，末尾 0 是数据库编号。
REDIS_URL=redis://127.0.0.1:6379/0

# ── ChromaDB（情景记忆 + 用户画像）─────────────────────────────────────────────
# docker compose 内部地址（连接独立 ChromaDB 服务）
# 独立 ChromaDB 服务的主机名。chromadb 是 Docker 网络内的服务名；连接失败时，项目会尝试本地嵌入式存储。
CHROMA_HOST=127.0.0.1
# 独立 ChromaDB 服务的端口。它和 API_PORT 属于不同服务，在 Docker 内可以使用相同的端口号。
CHROMA_PORT=8001
# 降级用本地路径（ChromaDB 服务不可用时自动切换）
# 嵌入式 ChromaDB 保存知识库、情景记忆和用户画像的目录。Windows 本机运行时应指向本机可写的目录。
CHROMA_PERSIST_DIRECTORY=D:/Temp/Agent/EchoMind/EchoMind/EchoMind/data/chroma

# ── 监控 ──────────────────────────────────────────────────────────────────────
# 额外提供监控指标的 HTTP 端口，供 Prometheus 抓取。设为 0 会关闭这个额外的监听端口。
PROMETHEUS_PORT=9091
# 后台监控每隔多少秒采集一次运行指标。例如 10 表示每 10 秒采集一次。
MONITOR_INTERVAL=10
# 接收监控告警的 HTTP 地址。留空时，项目不会向外部地址推送告警。
ALERT_WEBHOOK_URL=
